# Derived VM image: upstream Bluefin plus the guest configuration the stock image
# and config.toml can't provide. One piece (the clipboard-agent wiring) works
# around an upstream bug; the rest is VM/Tart-specific glue (sshd, the host-share
# mount, ~/Shared, first-boot provisioning) that belongs here regardless.
# Default base for building this layer by hand. `just build image` overrides it
# with the configured default_image, so this only needs to be a bootable arm64
# Bluefin.
ARG BASE=ghcr.io/projectbluefin/bluefin:lts-testing-arm64
FROM ${BASE}

# Re-declared so the RUN layers below can read them; BUILD_REF/BUILD_SHA are the
# git ref and commit that bin/build-image.sh passes in.
ARG BASE
ARG BUILD_REF=unknown
ARG BUILD_SHA=unknown

# 0. Build identity: stamp the source ref, commit, and base image so any disk
#    self-identifies (`cat /usr/lib/bluefin-vm/build-info`) regardless of how it
#    is later named or published. No timestamp -- keeps the layer reproducible.
RUN mkdir -p /usr/lib/bluefin-vm && \
    printf 'ref=%s\ncommit=%s\nbase=%s\n' "$BUILD_REF" "$BUILD_SHA" "$BASE" \
      > /usr/lib/bluefin-vm/build-info

# 1. Clipboard: the packaged spice-vdagent user unit is static and GNOME 50
#    ignores its legacy autostart entry, so nothing starts the agent. Wire it
#    into graphical sessions -- conditionally (installs without a SPICE
#    channel skip it at zero cost) and ordered After= the session, because an
#    unordered start races the session environment and exits in ~40ms with
#    "could not connect to X-server".
# 2. ~/Shared: give new users (created from /etc/skel) the symlink to
#    the host share's guest-side mountpoint.
RUN mkdir -p /usr/lib/systemd/user/graphical-session.target.wants \
             /usr/lib/systemd/user/spice-vdagent.service.d && \
    ln -s ../spice-vdagent.service \
      /usr/lib/systemd/user/graphical-session.target.wants/spice-vdagent.service && \
    printf '[Unit]\nConditionPathExists=/dev/virtio-ports/com.redhat.spice.0\nAfter=graphical-session.target\nPartOf=graphical-session.target\n\n[Service]\nRestart=on-failure\n' \
      > /usr/lib/systemd/user/spice-vdagent.service.d/10-vm-only.conf && \
    ln -s /var/mnt/shared/bluefin-share /etc/skel/Shared

# 3. sshd on by default (preset + enable) -- a VM you cannot reach is useless.
# 4. The host-share mount as a condition-gated unit: it activates only when a
#    virtiofs device is present, so boots without a share attached skip
#    cleanly (inactive, not failed) -- something fstab lines and kernel-arg
#    mounts cannot express.
RUN printf 'enable sshd.service\n' > /usr/lib/systemd/system-preset/45-bluefin-vm.preset && \
    systemctl enable sshd.service && \
    printf '[Unit]\nDescription=Host share over virtiofs (Tart)\nConditionPathExistsGlob=/sys/fs/virtiofs/*/tag\n\n[Mount]\nWhat=com.apple.virtio-fs.automount\nWhere=/var/mnt/shared\nType=virtiofs\n' \
      > /usr/lib/systemd/system/var-mnt-shared.mount && \
    mkdir -p /usr/lib/systemd/system/multi-user.target.wants && \
    ln -s ../var-mnt-shared.mount \
      /usr/lib/systemd/system/multi-user.target.wants/var-mnt-shared.mount

# 5. First-boot provisioning: a oneshot that, when the host has written
#    account details into the share, creates the user so a downloaded disk
#    feels personal. Gated on the details file (absent => skipped, baked login
#    stays); ordered After= the share mount so the file is visible, and Before=
#    login/greeter so the account and its autologin exist first. provision.sh
#    carries the credential-model rationale. bluefin-vm-harden is the opt-in
#    lock-down (password + drop the passwordless-sudo rule).
COPY provision.sh /usr/libexec/bluefin-vm-provision
COPY harden.sh /usr/bin/bluefin-vm-harden
RUN chmod 0755 /usr/libexec/bluefin-vm-provision /usr/bin/bluefin-vm-harden && \
    printf '[Unit]\nDescription=First-boot provisioning from the host share (bluefin-vm)\nConditionPathExists=/var/mnt/shared/bluefin-share/.bluefin-vm/username\nAfter=var-mnt-shared.mount\nBefore=gdm.service systemd-user-sessions.service\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/usr/libexec/bluefin-vm-provision\n\n[Install]\nWantedBy=multi-user.target\n' \
      > /usr/lib/systemd/system/bluefin-vm-provision.service && \
    ln -s ../bluefin-vm-provision.service \
      /usr/lib/systemd/system/multi-user.target.wants/bluefin-vm-provision.service
